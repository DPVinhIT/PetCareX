<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    
    <connectionStrings>
        <!-- Option 1: Windows Authentication (không cần user/password) -->
        <add name="PetCareXDB" 
             connectionString="Data Source=LAPTOP-NM0B6K40\SQLEXPRESS;Initial Catalog=PetCareX_DB;Integrated Security=True;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        
        <!-- Option 2: SQL Server Authentication (cần user/password) -->
        <!-- 
        <add name="PetCareXDB" 
             connectionString="Data Source=YOUR_SERVER_NAME;Initial Catalog=PetCareX_DB1;User ID=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        -->
    </connectionStrings>
</configuration>